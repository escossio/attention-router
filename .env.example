# Local demonstration only. Public sample values are NOT production credentials.
# REQUIRED values below make local Compose work; replace credentials before any shared deployment.
# OPTIONAL providers stay disabled. No WhatsApp account, OpenAI, STT or TTS is needed for local routing.
# OpenAI: configure OPENAI_API_KEY explicitly before enabling ANDY_AGENT_ENABLED.
# TTS/STT: separately deployed compatible service and internal authentication; see docs/guides/voice.md.
# WhatsApp: separate transport process and HMAC secret; never expose browser/auth state.
# Keep .env private. Do not reuse these demonstration credentials.
# OPTIONAL
APP_NAME=Attention Router
# OPTIONAL
APP_ENV=development
# OPTIONAL
HTTP_HOST=0.0.0.0
# OPTIONAL
HTTP_PORT=18100
# OPTIONAL
INGRESS_HTTP_HOST=0.0.0.0
# OPTIONAL
INGRESS_HTTP_PORT=18101
# OPTIONAL
INTERNAL_INGRESS_HTTP_HOST=0.0.0.0
# OPTIONAL
INTERNAL_INGRESS_HTTP_PORT=18102
# REQUIRED
INTERNAL_INGRESS_HMAC_SECRET=example-only-local-hmac-secret-00000000 # gitleaks:allow
# OPTIONAL
INTERNAL_INGRESS_MAX_SKEW_SECONDS=300
# OPTIONAL
INTERNAL_INGRESS_MAX_BODY_BYTES=65536
# OPTIONAL
INTERNAL_INGRESS_SOURCE=wwebjs
# REQUIRED
DATABASE_URL=postgresql+psycopg://attention_router:example-only-local-password@db:5432/attention_router # gitleaks:allow
# OPTIONAL
WORKER_POLL_INTERVAL_SECONDS=2
# OPTIONAL
WORKER_TIMER_LEASE_SECONDS=60
# OPTIONAL
DEFAULT_ACK_TIMEOUT_SECONDS=300
# OPTIONAL
ADMIN_AUTH_ENABLED=true
# REQUIRED
ADMIN_TOKEN=example-only-local-admin-token-0000 # gitleaks:allow
# OPTIONAL
HUMAN_IDENTITY_ENABLED=false
# OPTIONAL
HUMAN_AUTH_CHALLENGE_TTL_SECONDS=300
# OPTIONAL
GOOGLE_IDENTITY_AUDIENCE=
# OPTIONAL
META_WHATSAPP_ENABLED=false
# OPTIONAL
META_WEBHOOK_DISPATCH_ENABLED=false
# OPTIONAL
META_VERIFY_TOKEN=replace-with-local-random-meta-verify-token
# OPTIONAL
META_APP_SECRET=replace-with-meta-app-secret
# OPTIONAL
META_APP_ID=
# OPTIONAL
META_WABA_ID=
# OPTIONAL
META_PHONE_NUMBER_ID=
# OPTIONAL
META_GRAPH_API_VERSION=v26.0
# OPTIONAL
META_WEBHOOK_PUBLIC_HOSTNAME=
# OPTIONAL
META_MAX_WEBHOOK_BODY_BYTES=262144
# OPTIONAL
META_ADMISSION_GRACE_SECONDS=30
# OPTIONAL
META_ADMISSION_TRANSACTION_TIMEOUT_SECONDS=10
# OPTIONAL
META_RECONCILIATION_BATCH_SIZE=100
# OPTIONAL
META_RECONCILIATION_TRANSACTION_TIMEOUT_SECONDS=15
# OPTIONAL
META_ACCESS_TOKEN=
# OPTIONAL
META_WHATSAPP_ACCESS_TOKEN=
# OPTIONAL
META_WHATSAPP_PHONE_NUMBER_ID=
# OPTIONAL
META_WHATSAPP_WABA_ID=
# OPTIONAL
AGENT_BUILDER_INTERVIEWER_PROVIDER=deterministic
# OPTIONAL
AGENT_BUILDER_OPENAI_MODEL=gpt-5-mini
# OPTIONAL
AGENT_BUILDER_AI_TIMEOUT_SECONDS=20
# OPTIONAL
OPENAI_API_KEY=
# OPTIONAL
TTS_ENABLED=false
# OPTIONAL
TTS_PROFILE=andy
# OPTIONAL
TTS_AUTO_SEND=false
# OPTIONAL
TTS_INTERNAL_URL=http://tts-api-switcher:8090/internal/tts
