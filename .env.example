# Local demonstration only. Public sample values are NOT production credentials.
# REQUIRED values below make local Compose work; replace credentials before any shared deployment.
# OPTIONAL providers stay disabled. No WhatsApp account, OpenAI, STT or TTS is needed for local routing.
# OpenAI: configure OPENAI_API_KEY explicitly before enabling ANDY_AGENT_ENABLED.
# TTS/STT: separately deployed compatible service and internal authentication; see docs/guides/voice.md.
# WhatsApp: separate transport process and HMAC secret; never expose browser/auth state.
# Keep .env private. Do not reuse these demonstration credentials.
# OPTIONAL
APP_NAME=Attention Router
# OPTIONAL
APP_ENV=development
# OPTIONAL
HTTP_HOST=0.0.0.0
# OPTIONAL
HTTP_PORT=18100
# OPTIONAL
INGRESS_HTTP_HOST=0.0.0.0
# OPTIONAL
INGRESS_HTTP_PORT=18101
# OPTIONAL - provider-neutral integration admission remains disabled until a connector is provisioned
INTEGRATION_INGRESS_ENABLED=false
# OPTIONAL - trusted deployment audience for integration credentials
INTEGRATION_INGRESS_AUDIENCE=andy-integration-ingress
# OPTIONAL - admitted integration events remain queued until dispatch is explicitly enabled
INTEGRATION_DISPATCH_ENABLED=false
# OPTIONAL
INTEGRATION_DISPATCH_BATCH_SIZE=20
# OPTIONAL - real product Gmail connection via authenticated Client Session
GMAIL_CONNECT_ENABLED=false
# OPTIONAL - one-shot governed product runner; remains off until explicitly enabled
GMAIL_PRODUCT_RUNNER_ENABLED=false
# OPTIONAL - neutral ingress target used by the product runner
GMAIL_PRODUCT_RUNNER_INGRESS_URL=http://ingress:18101/api/v1/ingress/integrations/events
# OPTIONAL - bounded messages selected per one-shot/incremental run
GMAIL_PRODUCT_RUNNER_MAX_RESULTS=5
# OPTIONAL - automatic incremental Gmail scheduler; remains disabled until explicitly enabled
GMAIL_PRODUCT_SCHEDULER_ENABLED=false
# OPTIONAL - seconds between bounded scheduler cycles
GMAIL_PRODUCT_SCHEDULER_POLL_INTERVAL_SECONDS=30
# OPTIONAL - active Gmail installations selected per scheduler cycle
GMAIL_PRODUCT_SCHEDULER_BATCH_SIZE=20
# OPTIONAL - maximum Gmail history pages examined per installation/cycle
GMAIL_PRODUCT_SCHEDULER_MAX_PAGES=10
# OPTIONAL - attachment ingestion; requires Gmail readonly authority + Artifact Store
GMAIL_ATTACHMENT_INGESTION_ENABLED=false
# OPTIONAL - maximum attachment count per message
GMAIL_ATTACHMENT_MAX_COUNT=10
# OPTIONAL - maximum decoded bytes accepted for one Gmail attachment
GMAIL_ATTACHMENT_MAX_BYTES=26214400
# OPTIONAL - maximum decoded attachment bytes accepted for one Gmail message
GMAIL_ATTACHMENT_MAX_TOTAL_BYTES=33554432
# OPTIONAL - maximum traversed MIME nesting depth
GMAIL_ATTACHMENT_MAX_MIME_DEPTH=12
# OPTIONAL - Web OAuth client used by Android AuthorizationClient offline access
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# OPTIONAL - server-side OAuth client secret; never ship in Android
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
# OPTIONAL - 32-byte unpadded base64url AES-GCM key for provider secret envelopes
PROVIDER_AUTHORIZATION_KEY_B64URL=
# OPTIONAL - generic Artifact Plane byte store; remains disabled until explicitly enabled
ARTIFACT_STORE_ENABLED=false
# OPTIONAL - local content-addressed Artifact Store root
ARTIFACT_STORE_ROOT=/var/lib/attention-router/artifacts
# OPTIONAL - maximum bytes accepted for one opaque stored object
ARTIFACT_STORE_MAX_BYTES=33554432
# OPTIONAL - canonical WhatsApp media staging into Artifact Plane; remains disabled until explicitly enabled
WHATSAPP_ARTIFACT_INGESTION_ENABLED=false
# OPTIONAL - maximum decoded bytes accepted for one WhatsApp Artifact object
WHATSAPP_ARTIFACT_MAX_BYTES=33554432
# OPTIONAL - derived photo/PDF understanding; requires Artifact Store + OPENAI_API_KEY
ARTIFACT_UNDERSTANDING_ENABLED=false
# OPTIONAL - provider for derived understanding
ARTIFACT_UNDERSTANDING_PROVIDER=openai
# OPTIONAL - multimodal model used for photo/PDF understanding
ARTIFACT_UNDERSTANDING_MODEL=gpt-5.6-sol
# OPTIONAL - maximum bytes sent to the understanding provider
ARTIFACT_UNDERSTANDING_MAX_BYTES=20971520
# OPTIONAL - provider timeout in seconds
ARTIFACT_UNDERSTANDING_TIMEOUT_SECONDS=60
# OPTIONAL - stale PROCESSING lease before a job may be reclaimed
ARTIFACT_UNDERSTANDING_PROCESSING_LEASE_SECONDS=180
# OPTIONAL - bounded Artifact Understanding jobs claimed per worker cycle
ARTIFACT_UNDERSTANDING_BATCH_SIZE=10
# OPTIONAL - maximum structured response tokens
ARTIFACT_UNDERSTANDING_MAX_OUTPUT_TOKENS=4096
# OPTIONAL
INTERNAL_INGRESS_HTTP_HOST=0.0.0.0
# OPTIONAL
INTERNAL_INGRESS_HTTP_PORT=18102
# REQUIRED
INTERNAL_INGRESS_HMAC_SECRET=example-only-local-hmac-secret-00000000 # gitleaks:allow
# OPTIONAL
INTERNAL_INGRESS_MAX_SKEW_SECONDS=300
# OPTIONAL
INTERNAL_INGRESS_MAX_BODY_BYTES=65536
# OPTIONAL
INTERNAL_INGRESS_SOURCE=wwebjs
# REQUIRED
DATABASE_URL=postgresql+psycopg://attention_router:example-only-local-password@db:5432/attention_router # gitleaks:allow
# OPTIONAL
WORKER_POLL_INTERVAL_SECONDS=2
# OPTIONAL
WORKER_TIMER_LEASE_SECONDS=60
# OPTIONAL
DEFAULT_ACK_TIMEOUT_SECONDS=300
# OPTIONAL
ADMIN_AUTH_ENABLED=true
# REQUIRED
ADMIN_TOKEN=example-only-local-admin-token-0000 # gitleaks:allow
# OPTIONAL
HUMAN_IDENTITY_ENABLED=false
# OPTIONAL
HUMAN_AUTH_CHALLENGE_TTL_SECONDS=300
# OPTIONAL
HUMAN_AUTH_CONTINUATION_GRANT_TTL_SECONDS=300
# OPTIONAL - V0.3B remains fail-closed until explicitly enabled
DEVICE_BOOTSTRAP_ENABLED=false
# OPTIONAL
DEVICE_BOOTSTRAP_CHALLENGE_TTL_SECONDS=300
# OPTIONAL - V0.3C remains fail-closed until explicitly enabled
CLIENT_SESSION_ENABLED=false
# OPTIONAL
CLIENT_SESSION_CHALLENGE_TTL_SECONDS=300
# OPTIONAL
CLIENT_SESSION_TTL_SECONDS=900
# OPTIONAL - authenticated native-app human approval inbox/decision API
CLIENT_APPROVAL_ENABLED=false
# OPTIONAL - authenticated Andy text/voice command channel
CLIENT_COMMAND_ENABLED=false
# OPTIONAL
GOOGLE_IDENTITY_AUDIENCE=
# OPTIONAL
META_WHATSAPP_ENABLED=false
# OPTIONAL
META_WEBHOOK_DISPATCH_ENABLED=false
# OPTIONAL
META_VERIFY_TOKEN=replace-with-local-random-meta-verify-token
# OPTIONAL
META_APP_SECRET=replace-with-meta-app-secret
# OPTIONAL
META_APP_ID=
# OPTIONAL
META_WABA_ID=
# OPTIONAL
META_PHONE_NUMBER_ID=
# OPTIONAL
META_GRAPH_API_VERSION=v26.0
# OPTIONAL
META_WEBHOOK_PUBLIC_HOSTNAME=
# OPTIONAL
META_MAX_WEBHOOK_BODY_BYTES=262144
# OPTIONAL
META_ADMISSION_GRACE_SECONDS=30
# OPTIONAL
META_ADMISSION_TRANSACTION_TIMEOUT_SECONDS=10
# OPTIONAL
META_RECONCILIATION_BATCH_SIZE=100
# OPTIONAL
META_RECONCILIATION_TRANSACTION_TIMEOUT_SECONDS=15
# OPTIONAL
META_ACCESS_TOKEN=
# OPTIONAL
META_WHATSAPP_ACCESS_TOKEN=
# OPTIONAL
META_WHATSAPP_PHONE_NUMBER_ID=
# OPTIONAL
META_WHATSAPP_WABA_ID=
# OPTIONAL
AGENT_BUILDER_INTERVIEWER_PROVIDER=deterministic
# OPTIONAL
AGENT_BUILDER_OPENAI_MODEL=gpt-5-mini
# OPTIONAL
AGENT_BUILDER_AI_TIMEOUT_SECONDS=20
# OPTIONAL
OPENAI_API_KEY=
# OPTIONAL
TTS_ENABLED=false
# OPTIONAL
TTS_PROFILE=andy
# OPTIONAL
TTS_AUTO_SEND=false
# OPTIONAL
TTS_INTERNAL_URL=http://tts-api-switcher:8090/internal/tts
# OPTIONAL
TTS_INTERNAL_TOKEN=
# OPTIONAL
TTS_TIMEOUT_SECONDS=20
# OPTIONAL
TTS_PROCESSING_LEASE_SECONDS=120
# OPTIONAL
TTS_MAX_RESPONSE_BYTES=5242880
# OPTIONAL
WHATSAPP_MEDIA_ROOT=/var/lib/attention-router/whatsapp-media
# OPTIONAL
WHATSAPP_MEDIA_MAX_BYTES=5242880
# OPTIONAL
MEDIA_RETENTION_HOURS=24
# OPTIONAL
MEDIA_AMBIGUOUS_RETENTION_HOURS=168
# OPTIONAL
STT_ENABLED=false
# OPTIONAL
STT_INTERNAL_URL=http://tts-api-switcher:8090/internal/stt
# OPTIONAL
STT_INTERNAL_TOKEN=
# OPTIONAL
STT_TIMEOUT_SECONDS=30
# OPTIONAL
STT_PROCESSING_LEASE_SECONDS=120
# OPTIONAL
AGENT_DECISION_PIPELINE_ENABLED=true
# OPTIONAL
ANDY_BEHAVIOR_ENABLED=false
# OPTIONAL
ANDY_BEHAVIOR_CANARY_BINDING_ID=
# OPTIONAL
ANDY_BEHAVIOR_PROFILE_PATH=config/andy_behavior_profile.json
# OPTIONAL
ANDY_AGENT_ENABLED=false
# OPTIONAL
ANDY_AGENT_MODEL=gpt-5.6-sol
# OPTIONAL
ANDY_AGENT_TIMEOUT_SECONDS=20
# OPTIONAL
ANDY_AGENT_MAX_TURNS=3
# OPTIONAL - semantic owner-control fallback after exact deterministic parsing
OWNER_CONTROL_SEMANTIC_ENABLED=false
# OPTIONAL
OWNER_CONTROL_SEMANTIC_MODEL=gpt-5.6-sol
# OPTIONAL - bounded lifetime for an unresolved owner clarification
OWNER_CONTROL_CLARIFICATION_TTL_SECONDS=120
# OPTIONAL - Personal Context runtime orchestration stays off until explicitly enabled
PERSONAL_CONTEXT_RUNTIME_ENABLED=false
# OPTIONAL
PERSONAL_CONTEXT_RUNTIME_INTERVAL_SECONDS=300
# OPTIONAL - recommendation delivery is a separate switch
PERSONAL_CONTEXT_RECOMMENDATION_DELIVERY_ENABLED=false
# OPTIONAL - proposal-only anomaly suggestion delivery is separately gated
PERSONAL_CONTEXT_SUGGESTION_DELIVERY_ENABLED=false
# OPTIONAL - accepted recommendation authority evaluation is separately gated
PERSONAL_CONTEXT_AUTHORITY_RUNTIME_ENABLED=false
# OPTIONAL - governed reminder materialization is separately gated
PERSONAL_CONTEXT_MATERIALIZATION_RUNTIME_ENABLED=false
# OPTIONAL
PERSONAL_CONTEXT_MATERIALIZATION_INTENT_LIMIT=50
# OPTIONAL
PERSONAL_CONTEXT_RUNTIME_OWNER_LIMIT=50
# OPTIONAL
AGENT_RESPONSE_REVIEW_ENABLED=true
# OPTIONAL
AGENT_EXECUTION_ENABLED=true
# OPTIONAL
EXTERNAL_DELIVERY_ENABLED=false
# OPTIONAL
