OTEL_TRACES_SAMPLER_ARG=1.0
# OPTIONAL — HTTP exporter timeout (milliseconds; 1..10000)
OTEL_EXPORT_TIMEOUT_MILLIS=5000
# OPTIONAL — explicit flush wait budget (milliseconds; 0..10000)
OTEL_FLUSH_TIMEOUT_MILLIS=1000
