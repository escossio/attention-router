# Installed outside Git at /etc/attention-router/agt-production.env.
# The real HMAC value must be supplied by the host-local secret store.
HOME=/home/example
XDG_RUNTIME_DIR=/tmp/example-runtime
DISPLAY=:98
BROWSER_DEBUG_HOST=127.0.0.1
BROWSER_DEBUG_PORT=9223
LOCAL_TRANSPORT_HTTP_HOST=127.0.0.1
LOCAL_TRANSPORT_HTTP_PORT=18103
INBOUND_FORWARD_ENABLED=true
EXTERNAL_DELIVERY_ENABLED=false
INBOUND_FORWARD_URL=http://192.0.2.6:18102/api/v1/ingress/internal/events
LOCAL_INBOUND_FORWARD_ALLOWED_HOST=192.0.2.6
INTERNAL_INGRESS_HMAC_SECRET=<host-local-secret>
LOCAL_INBOUND_SPOOL_DIR=/var/lib/attention-router/whatsapp-transport
LOCAL_INBOUND_PENDING_DIR=/var/lib/attention-router/whatsapp-transport/pending
LOCAL_INBOUND_SENDING_DIR=/var/lib/attention-router/whatsapp-transport/sending
LOCAL_INBOUND_SENT_DIR=/var/lib/attention-router/whatsapp-transport/sent
LOCAL_INBOUND_QUARANTINE_DIR=/var/lib/attention-router/whatsapp-transport/quarantine
