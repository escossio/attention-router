# Gmail metadata-only connector. Install outside Git at:
# /etc/attention-router/gmail-connector.env
#
# Provider OAuth acquisition/refresh is external to Attention Router.
# Required Gmail scope:
# https://www.googleapis.com/auth/gmail.metadata

GMAIL_TENANT_ID=00000000-0000-4000-8000-000000000001
GMAIL_INTEGRATION_INSTANCE_ID=gmail-primary
GMAIL_INTEGRATION_ACCOUNT_ID=gmail-account-opaque

# Prefer file-backed short-lived OAuth access tokens so an external credential
# agent can rotate the value without placing it in process arguments.
GMAIL_ACCESS_TOKEN_FILE=/etc/attention-router/secrets/gmail-access-token

# Cursor contains only mailbox hash + Gmail historyId and is created mode 0600.
GMAIL_CONNECTOR_STATE_PATH=/var/lib/attention-router/gmail-connector/cursor.json

# Neutral Attention Router ingress. HTTPS is mandatory; redirects are rejected.
ATTENTION_ROUTER_INTEGRATION_ENDPOINT=https://ingress.example.invalid/api/v1/ingress/integrations/events
ATTENTION_ROUTER_INTEGRATION_CREDENTIAL_FILE=/etc/attention-router/secrets/gmail-integration-bearer

# OPTIONAL
GMAIL_POLL_INTERVAL_SECONDS=30
# OPTIONAL - fail closed before admitting more than this many messages in one poll
GMAIL_MESSAGE_LIMIT_PER_POLL=100
# OPTIONAL
GMAIL_HISTORY_PAGE_LIMIT=20
# OPTIONAL
GMAIL_REQUEST_TIMEOUT_SECONDS=15
# OPTIONAL
LOG_LEVEL=INFO
