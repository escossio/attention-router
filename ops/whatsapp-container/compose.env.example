# Synthetic example only. Real allocations belong in IPAM and a root-only host file.
WHATSAPP_CHROME_VERSION=155.0.8059.39-1
WHATSAPP_CHROME_SECCOMP_PROFILE=/path/to/repo/ops/whatsapp-container/chrome-seccomp.json
WHATSAPP_START_URL=about:blank
WHATSAPP_BROWSER_IMAGE=andy-whatsapp-browser:candidate
WHATSAPP_TRANSPORT_IMAGE=andy-whatsapp-transport:candidate
WHATSAPP_IMAGE_SOURCE_SHA=replace-with-candidate-commit-sha
WHATSAPP_TRANSPORT_SOURCE_SHA=20fb5427227d3583ade26089544e166b2afdeb70
WHATSAPP_UID=1000
WHATSAPP_GID=1000
WHATSAPP_PROFILE_DIR=/path/to/staging-profile
WHATSAPP_SPOOL_DIR=/path/to/staging-spool
WHATSAPP_MEDIA_DIR=/path/to/staging-media
WHATSAPP_OBSERVER_DIR=/path/to/staging-observer
WHATSAPP_TRANSPORT_ENV_FILE=/path/to/synthetic-transport.env
WHATSAPP_OBSERVER_ENV_FILE=/path/to/synthetic-observer.env
WHATSAPP_BROWSER_PARENT=example-parent.210
WHATSAPP_BROWSER_SUBNET=192.0.2.0/29
WHATSAPP_BROWSER_GATEWAY=192.0.2.1
WHATSAPP_BROWSER_IP=192.0.2.2
WHATSAPP_TRANSPORT_PARENT=example-parent.211
WHATSAPP_TRANSPORT_SUBNET=198.51.100.0/29
WHATSAPP_TRANSPORT_GATEWAY=198.51.100.1
WHATSAPP_TRANSPORT_IP=198.51.100.2
