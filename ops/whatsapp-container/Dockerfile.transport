FROM node:22.23.2-bookworm-slim

ARG SOURCE_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/escossio/attention-router" \
      org.opencontainers.image.revision="${SOURCE_SHA}"
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl socat tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY whatsapp-transport-local/package.json whatsapp-transport-local/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY whatsapp-transport-local/src ./src
COPY ops/whatsapp-container/transport-entrypoint.sh /usr/local/bin/transport-entrypoint
RUN chmod 0755 /usr/local/bin/transport-entrypoint
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/transport-entrypoint"]
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS "http://${LOCAL_TRANSPORT_HTTP_HOST:-127.0.0.1}:${LOCAL_TRANSPORT_HTTP_PORT:-18103}/ready" >/dev/null || exit 1
