FROM debian:bookworm-slim

ARG CHROME_VERSION=155.0.8059.39-1
ARG SOURCE_SHA=unknown
LABEL org.opencontainers.image.source="https://github.com/escossio/attention-router" \
      org.opencontainers.image.revision="${SOURCE_SHA}"
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg socat tini xvfb xauth fontconfig fonts-liberation procps \
    && curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && printf '%s\n' 'deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main' \
      > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends "google-chrome-stable=${CHROME_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1000 andy && useradd -u 1000 -g 1000 -m andy
COPY ops/whatsapp-container/browser-entrypoint.sh /usr/local/bin/browser-entrypoint
RUN chmod 0755 /usr/local/bin/browser-entrypoint
USER 1000:1000
ENV HOME=/home/andy DISPLAY=:98 XDG_RUNTIME_DIR=/tmp/andy-runtime
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/browser-entrypoint"]
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:9223/json/version >/dev/null || exit 1
