# Host-private runtime network topology. Copy values into
# /etc/attention-router/agt-network-namespace.env; do not commit live values.
ANDY_RUNTIME_NETWORK_PARENT=
ANDY_BROWSER_VLAN_ID=
ANDY_BROWSER_ADDRESS_CIDR=
ANDY_BROWSER_GATEWAY=
ANDY_BROWSER_CDP_BIND_HOST=
ANDY_BROWSER_CDP_BIND_PORT=9223
ANDY_BROWSER_CDP_TARGET_PORT=9223

ANDY_TRANSPORT_MACVLAN_BASE=andy-transport-base
ANDY_TRANSPORT_VLAN_ID=
ANDY_TRANSPORT_ADDRESS_CIDR=
ANDY_TRANSPORT_GATEWAY=
ANDY_TRANSPORT_DISABLE_TX_OFFLOADS=false
ANDY_TRANSPORT_CDP_LISTEN_PORT=9223

# Product-facing endpoints remain host-specific.
BROWSER_DEBUG_HOST=127.0.0.1
BROWSER_DEBUG_PORT=9223
BROWSER_DEBUG_URL=
CHROME_REMOTE_DEBUGGING_URL=
LOCAL_TRANSPORT_HTTP_HOST=
LOCAL_TRANSPORT_HTTP_PORT=18103
INBOUND_FORWARD_URL=
LOCAL_INBOUND_FORWARD_URL=
LOCAL_INBOUND_FORWARD_ALLOWED_HOST=
