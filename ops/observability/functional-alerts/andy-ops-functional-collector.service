[Unit]
Description=Andy Ops read-only per-core CPU and Tempo -> Zabbix ROC
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/andy-ops-alerts/collect.py
TimeoutStartSec=55
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
RestrictRealtime=true
