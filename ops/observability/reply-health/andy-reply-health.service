[Unit]
Description=Andy WhatsApp read-only reply evidence to Zabbix ROC
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/andy-ops-alerts/reply_health.py
TimeoutStartSec=50
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/midia/agt01-storage/attention-router/private
