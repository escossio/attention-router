# First-owner Cognitive Canary Profile V0
# Copy values into the managed runtime environment only after the exact merged
# GitHub SHA is deployed. Never commit real tenant/binding IDs or secrets.

# Exact rollout scope
PERSISTENT_MEMORY_CANARY_BINDING_ID=<actor-binding-row-id>
PERSONAL_CONTEXT_RUNTIME_CANARY_TENANT_ID=<tenant-id>
COGNITIVE_RUNTIME_CANARY_TENANT_ID=<tenant-id>

# Knowledge capture and deterministic cognition
PERSISTENT_MEMORY_ENABLED=true
MEMORY_INGESTION_ENABLED=true
MEMORY_CONTEXT_ENABLED=true
PERSONAL_CONTEXT_RUNTIME_ENABLED=true
COGNITIVE_RUNTIME_ENABLED=true

# Bounded defaults
PERSONAL_CONTEXT_RUNTIME_INTERVAL_SECONDS=300
PERSONAL_CONTEXT_RUNTIME_OWNER_LIMIT=50
COGNITIVE_RUNTIME_INTERVAL_SECONDS=300
COGNITIVE_RUNTIME_TENANT_LIMIT=50
COGNITIVE_RUNTIME_GRAPH_LIMIT_PER_KIND=200
COGNITIVE_RUNTIME_CANDIDATE_LIMIT=24

# Observation-only rollout: keep proactive/action boundaries OFF
PERSONAL_CONTEXT_RECOMMENDATION_DELIVERY_ENABLED=false
PERSONAL_CONTEXT_SUGGESTION_DELIVERY_ENABLED=false
PERSONAL_CONTEXT_AUTHORITY_RUNTIME_ENABLED=false
PERSONAL_CONTEXT_MATERIALIZATION_RUNTIME_ENABLED=false
LEARNED_GRAPH_SHADOW_ENABLED=false
EXTERNAL_DELIVERY_ENABLED=false
AUTONOMOUS_EXECUTION_ENABLED=false

# Intentionally not set here:
# - provider credentials
# - ANDY_AGENT_ENABLED / AGENT_DECISION_PIPELINE_ENABLED
# - AGENT_EXECUTION_ENABLED
# - transport-specific delivery policy
# Those remain governed by the existing deployed runtime policy and are not
# silently changed by the cognitive canary profile.
