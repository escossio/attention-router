# Copy to a protected private file outside Git. No live address or secret belongs here.
APP_ENV=production
ADMIN_AUTH_ENABLED=false
# Settings requires this even though this service does not start its HMAC listener.
INTERNAL_INGRESS_HMAC_SECRET=unused-by-maestro-standalone-only-000000000000
MAESTRO_RELAY_INGRESS_ENABLED=true
MAESTRO_HTTPS_LISTENER_ENABLED=true
# MAESTRO_HTTPS_BIND_HOST=<same reserved private IP as Compose>
MAESTRO_HTTPS_PORT=18443
