# Documentation template only; complete a protected copy outside Git.
# Compose interpolation variables belong in the operator shell/private Compose env:
# CHANNEL_SYNC_IMAGE=<certified-image-reference@sha256:digest>
# CHANNEL_SYNC_ENV_FILE=<absolute-path-to-private-runtime-env>
# CHANNEL_SYNC_NETWORK_NAME=<host-provisioned-dedicated-trust-zone>
# Never use this template as an enabled deployment without private configuration.
APP_ENV=production
# No admin HTTP server exists in this process; do not inject an admin bearer.
ADMIN_AUTH_ENABLED=false
# Shared Settings currently requires this even though no HMAC listener is started.
# INTERNAL_INGRESS_HMAC_SECRET=<host-private-value-at-least-32-characters>
# DATABASE_URL=<host-private-postgresql+psycopg-url>

# Existing Settings dependency for Connect; does not start a Client API here.
CLIENT_SESSION_ENABLED=false
GMAIL_CONNECT_ENABLED=false
GMAIL_PRODUCT_RUNNER_ENABLED=false
GMAIL_PRODUCT_SCHEDULER_ENABLED=false
GMAIL_BODY_INGESTION_ENABLED=false
# V1 service refuses attachments; no Artifact Plane network or volume.
GMAIL_ATTACHMENT_INGESTION_ENABLED=false
# GMAIL_PRODUCT_RUNNER_INGRESS_URL=<private-http-or-https-origin>/api/v1/ingress/integrations/events
GMAIL_PRODUCT_RUNNER_MAX_RESULTS=5
GMAIL_PRODUCT_SCHEDULER_POLL_INTERVAL_SECONDS=30
GMAIL_PRODUCT_SCHEDULER_BATCH_SIZE=20
GMAIL_PRODUCT_SCHEDULER_MAX_PAGES=10
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=<host-private-client-id>
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=<host-private-client-secret>
# PROVIDER_AUTHORIZATION_KEY_B64URL=<existing-host-private-32-byte-unpadded-base64url-key>
# Reuse the existing authorized key/client; do not generate replacement material.
# Refresh grants and integration bearers are persisted, never configured here.
