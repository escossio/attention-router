# Host-private deployment coordinates. Keep the real file out of Git.
ATTENTION_LIVE_PROJECT=attention-router-live-flow-stage4
ATTENTION_LIVE_DB_CONTAINER=attention-router-live-flow-stage4-db-1
ATTENTION_LIVE_WORKER_CONTAINER=attention-router-live-flow-stage4-worker-1
ATTENTION_LIVE_WORKDIR=/etc/attention-router
ATTENTION_LIVE_WORKER_SERVICE=worker
ATTENTION_LIVE_HEALTH_TIMEOUT_SECONDS=60

# Colon-separated local compose chain. The production execution overlay must be last.
ATTENTION_LIVE_WORKER_COMPOSE_FILES=/etc/attention-router/worker-base.compose.yaml:/etc/attention-router/worker-observability.compose.yaml:/etc/attention-router/worker-production-execution.compose.yaml
