#!/usr/bin/env bash
set -Eeuo pipefail

BASE="${ANDY_CI_BASE:-/usr/local/lib/andy-ci}"
PROFILE_ROOT="${ANDY_CI_PROFILE_ROOT:-$BASE/profiles}"
LOG_ROOT="${ANDY_CI_LOG_ROOT:-/var/log/andy-ci}"
REGISTRY_CLI="${ANDY_CI_HOST_REGISTRY_CLI:-$BASE/bin/host-registry.py}"
REGISTRY_DB="${ANDY_CI_HOST_REGISTRY_DB:-/var/lib/andy-ci/host-registry.sqlite3}"
CAPACITY="${ANDY_CI_CAPACITY_FILE:-$BASE/worker-capacity.json}"
SSH_BIN="${ANDY_CI_SSH_BIN:-ssh}"
CAPACITY_WAIT_SECONDS="${ANDY_CI_CAPACITY_WAIT_SECONDS:-300}"
PERSISTENT_JOB="${ANDY_CI_PERSISTENT_JOB:-0}"
if [[ "$PERSISTENT_JOB" == 1 ]]; then CAPACITY_WAIT_SECONDS=0; fi

capacity_pending() {
  echo 'CI_DISTRIBUTED_ADMISSION=WAITING_CAPACITY'
  exit 75
}
POSTGRES_WORKER="${ANDY_CI_POSTGRES_WORKER:-ci03}"

SHA="${1:-}"
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || {
  echo 'usage: andy-ci-reprofile <40-char-sha>' >&2
  exit 64
}

RUN_ID="$(date +%Y%m%dT%H%M%S)-${SHA:0:12}-postgres-profile"
RUN_DIR="$LOG_ROOT/$RUN_ID"
mkdir -p "$RUN_DIR" "$PROFILE_ROOT"

registry() { python3 "$REGISTRY_CLI" --db "$REGISTRY_DB" "$@"; }
host_target() { registry field --host-id "$1" --name access_target; }
set_health() { registry set-health --host-id "$1" --state "$2" --reason "$3"; }

mapfile -t POSTGRES_CAPABLE_WORKERS < <(registry list-workers --capability postgres-worker)
CONFIGURED_WORKERS=()
for worker in "${POSTGRES_CAPABLE_WORKERS[@]}"; do
  if [[ "$worker" == "$POSTGRES_WORKER" ]]; then
    CONFIGURED_WORKERS+=("$worker")
  fi
done
((${#CONFIGURED_WORKERS[@]} == 1)) || {
  echo "CI_REPROFILE_STATUS=POSTGRES_WORKER_NOT_CONFIGURED worker=$POSTGRES_WORKER"
  exit 69
}
echo "CI_REPROFILE_POSTGRES_WORKER=$POSTGRES_WORKER"

declare -a READY_WORKERS=()
declare -A PROBED_DEPENDENCIES=()
probe_dependency() {
  local host="$1" depth="${2:-0}"
  (( depth < 8 )) || return 1
  [[ "${PROBED_DEPENDENCIES[$host]:-}" == READY ]] && return 0
  [[ "${PROBED_DEPENDENCIES[$host]:-}" == UNAVAILABLE ]] && return 1
  local dep
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    if ! probe_dependency "$dep" $((depth + 1)); then
      PROBED_DEPENDENCIES[$host]=UNAVAILABLE
      set_health "$host" UNAVAILABLE "dependency_unavailable:$dep"
      return 1
    fi
  done < <(registry dependencies --host-id "$host")
  local target; target="$(host_target "$host")"
  if "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=5 "$target" true >/dev/null 2>&1; then
    PROBED_DEPENDENCIES[$host]=READY
    set_health "$host" READY ssh_ready
    return 0
  fi
  PROBED_DEPENDENCIES[$host]=UNAVAILABLE
  set_health "$host" UNAVAILABLE ssh_unreachable
  return 1
}

probe_worker() {
  local worker="$1" dep
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    if ! probe_dependency "$dep" 0; then
      set_health "$worker" UNAVAILABLE "dependency_unavailable:$dep"
      return 1
    fi
  done < <(registry dependencies --host-id "$worker")
  local target; target="$(host_target "$worker")"
  if ! "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=5 "$target" \
      'test -x /srv/andy-ci/bin/andy-ci-run && docker info >/dev/null' >/dev/null 2>&1; then
    set_health "$worker" UNAVAILABLE worker_preflight_failed
    return 1
  fi

  if "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=5 "$target" \
      'flock -n /srv/andy-ci/worker.lock -c true' >/dev/null 2>&1; then
    set_health "$worker" READY worker_ready
    return 0
  fi

  set_health "$worker" DEGRADED worker_busy
  return 1
}

refresh_pool() {
  READY_WORKERS=()
  PROBED_DEPENDENCIES=()
  local worker
  for worker in "${CONFIGURED_WORKERS[@]}"; do
    if probe_worker "$worker"; then
      READY_WORKERS+=("$worker")
    fi
  done
}

ordered_workers() {
  python3 - "$CAPACITY" "$@" <<'PY'
import json,pathlib,sys
cap=json.loads(pathlib.Path(sys.argv[1]).read_text())["pytest_full_seconds"]
workers=[w for w in sys.argv[2:] if w in cap]
for w in sorted(workers,key=lambda n:(float(cap[n]),n)): print(w)
PY
}

DISCOVERY_DONE=0
DISCOVERY_DEADLINE=$(( $(date +%s) + CAPACITY_WAIT_SECONDS ))
DISCOVERY_COMMAND="ANDY_CI_DISCOVER_POSTGRES=1 /srv/andy-ci/bin/andy-ci-run '${SHA}' postgres"

while [[ "$PERSISTENT_JOB" == 1 ]] || (( $(date +%s) < DISCOVERY_DEADLINE )); do
  refresh_pool
  if ((${#READY_WORKERS[@]} == 0)); then
    [[ "$PERSISTENT_JOB" != 1 ]] || capacity_pending
    echo 'CI_REPROFILE_STATUS=WAITING_FOR_DISCOVERY_CAPACITY'
    sleep 3
    continue
  fi

  while IFS= read -r worker; do
    [[ -n "$worker" ]] || continue
    target="$(host_target "$worker")"
    raw="$RUN_DIR/discovery-${worker}.txt"
    # andy-ci-run owns the worker flock. A nested flock would deadlock.
    if "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=5 "$target" \
        "$DISCOVERY_COMMAND" >"$raw" 2>/dev/null; then
      if python3 "$BASE/bin/parse-postgres-discovery.py" \
          --sha "$SHA" --log "$raw" --output "$RUN_DIR/postgres-files.txt" \
          --selection-output "$RUN_DIR/selection.txt"; then
        DISCOVERY_DONE=1
        echo "CI_REPROFILE_DISCOVERY_WORKER=$worker"
        break
      fi
      echo "CI_REPROFILE_DISCOVERY_INVALID worker=$worker"
      set_health "$worker" DEGRADED invalid_discovery_manifest
      exit 70
    fi
    if grep -q '^CI_STATUS=FAIL$' "$raw"; then
      echo 'CI_REPROFILE_STATUS=DISCOVERY_SETUP_FAILED'
      tail -n 100 "$raw"
      exit 70
    fi
    set_health "$worker" DEGRADED discovery_busy_or_failed
  done < <(ordered_workers "${READY_WORKERS[@]}")

  (( DISCOVERY_DONE == 1 )) && break
  [[ "$PERSISTENT_JOB" != 1 ]] || capacity_pending
  sleep 3
done

(( DISCOVERY_DONE == 1 )) || {
  echo 'CI_REPROFILE_STATUS=NO_DISCOVERY_CAPACITY'
  exit 69
}
SELECTION_SHA="$(sed -n '2p' "$RUN_DIR/selection.txt")"
PROFILE_KEY="nodes-$SELECTION_SHA"
PROFILE="$PROFILE_ROOT/$PROFILE_KEY"
echo "CI_REPROFILE_SHA=$SHA"
echo "CI_REPROFILE_PROFILE_KEY=$PROFILE_KEY"

if [[ -f "$PROFILE/manifest.json" ]] \
  && cmp -s "$PROFILE/postgres-files.txt" "$RUN_DIR/postgres-files.txt" \
  && cmp -s "$PROFILE/selection.txt" "$RUN_DIR/selection.txt"; then
  echo 'CI_REPROFILE_STATUS=CACHED'
  echo "CI_REPROFILE_MANIFEST=$PROFILE/manifest.json"
  exit 0
fi

PROFILE_OK=0
PROFILE_DEADLINE=$(( $(date +%s) + CAPACITY_WAIT_SECONDS ))
while [[ "$PERSISTENT_JOB" == 1 ]] || (( $(date +%s) < PROFILE_DEADLINE )); do
  refresh_pool
  if (( ${#READY_WORKERS[@]} == 0 )); then
    [[ "$PERSISTENT_JOB" != 1 ]] || capacity_pending
    echo 'CI_REPROFILE_STATUS=WAITING_FOR_PROFILE_CAPACITY'
    sleep 3
    continue
  fi
  worker="${READY_WORKERS[0]}"
  target="$(host_target "$worker")"
  stdout="$RUN_DIR/${worker}-profile.stdout.log"
  set +e
  "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout=5 "$target" \
    "ANDY_CI_PROFILE_DURATIONS=1 ANDY_CI_POSTGRES_SELECTION_SHA256='$SELECTION_SHA' \
     /srv/andy-ci/bin/andy-ci-run '$SHA' postgres" \
    > "$stdout" 2>&1
  rc=$?
  set -e

  if (( rc != 0 )); then
    if (( rc == 75 )) && grep -Fxq CI_WORKER_BUSY "$stdout"; then
      set_health "$worker" DEGRADED worker_busy
      [[ "$PERSISTENT_JOB" != 1 ]] || capacity_pending
      sleep 3
      continue
    fi
    if (( rc == 255 )); then
      set_health "$worker" UNAVAILABLE profiling_worker_lost
      [[ "$PERSISTENT_JOB" != 1 ]] || exit "$rc"
      sleep 3
      continue
    fi
    if grep -q '^CI_STATUS=FAIL$' "$stdout" \
      && grep -Eq '^CI_POSTGRES_STAGE=(settings|alembic|pytest)$' "$stdout"; then
      echo 'CI_REPROFILE_STATUS=TEST_FAILURE'
      tail -n 100 "$stdout"
      exit "$rc"
    fi
    echo 'CI_REPROFILE_STATUS=INFRA_FAILURE'
    exit "$rc"
  fi

  if ! python3 "$BASE/bin/parse-postgres-discovery.py" --profile \
      --sha "$SHA" --log "$stdout" --output "$RUN_DIR/profile-files.txt" \
      --selection-output "$RUN_DIR/profile-selection.txt" \
      || ! cmp -s "$RUN_DIR/selection.txt" "$RUN_DIR/profile-selection.txt" \
      || ! cmp -s "$RUN_DIR/postgres-files.txt" "$RUN_DIR/profile-files.txt"; then
    echo 'CI_REPROFILE_STATUS=INVALID_EXECUTION_RECEIPT'
    exit 70
  fi

  cp "$stdout" "$RUN_DIR/profile.log"
  set_health "$worker" READY profile_pass
  PROFILE_OK=1
  echo "CI_REPROFILE_WORKER=$worker"
  break
done

(( PROFILE_OK == 1 )) || {
  echo 'CI_REPROFILE_STATUS=NO_PROFILE_CAPACITY'
  exit 69
}

NEW_PROFILE="$PROFILE_ROOT/.${PROFILE_KEY}.new-$RUN_ID"
rm -rf "$NEW_PROFILE"
mkdir -p "$NEW_PROFILE"
python3 "$BASE/bin/plan-postgres.py" \
  --log "$RUN_DIR/profile.log" \
  --capacity "$CAPACITY" \
  --output-dir "$NEW_PROFILE" \
  --source-sha "$SHA" \
  --selection-sha256 "$SELECTION_SHA"

if ! cmp -s "$NEW_PROFILE/postgres-files.txt" "$RUN_DIR/postgres-files.txt"; then
  echo 'profile file-set mismatch' >&2
  rm -rf "$NEW_PROFILE"
  exit 70
fi
cp "$RUN_DIR/selection.txt" "$NEW_PROFILE/selection.txt"

rm -rf "$PROFILE"
mv "$NEW_PROFILE" "$PROFILE"

echo 'CI_REPROFILE_STATUS=PASS'
echo "CI_REPROFILE_PROFILE_KEY=$PROFILE_KEY"
echo "CI_REPROFILE_MANIFEST=$PROFILE/manifest.json"
