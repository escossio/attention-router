<VirtualHost *:80>
    ServerName cognitive.escossio.com
    DocumentRoot /srv/cognitive.escossio.com/public
    DirectoryIndex index.html

    <Directory /srv/cognitive.escossio.com/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    ErrorLog ${APACHE_LOG_DIR}/cognitive.escossio.com-error.log
    CustomLog ${APACHE_LOG_DIR}/cognitive.escossio.com-access.log combined
</VirtualHost>
