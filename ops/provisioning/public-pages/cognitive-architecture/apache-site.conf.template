<VirtualHost *:80>
    ServerName cognitive.escossio.com
    DocumentRoot /srv/cognitive.escossio.com/public
    DirectoryIndex index.html

    <Directory /srv/cognitive.escossio.com/public>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    <FilesMatch "\\.(?:html|js|json)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
    </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/cognitive.escossio.com-error.log
    CustomLog ${APACHE_LOG_DIR}/cognitive.escossio.com-access.log combined
</VirtualHost>
