# Host-specific values stay outside Git.
ANDY_OPS_LISTEN_ADDRESS=127.0.0.1
ANDY_OPS_LISTEN_PORT=18121
ANDY_OPS_POLL_SECONDS=1.5
ANDY_OPS_SSH_TIMEOUT=1.2
ANDY_OPS_CI01_HOST=ci01
ANDY_OPS_CI02_HOST=ci02
ANDY_OPS_CI03_HOST=ci03
ANDY_OPS_CI_LOG_ROOT=/var/log/andy-ci
# Optional. Default: ~/.claude-server-commander/tool-history.jsonl
# ANDY_OPS_TOOL_HISTORY=/path/to/tool-history.jsonl

# Optional LAN-only observability embeds. Leave blank when not configured.
# ANDY_OPS_GOACCESS_URL=http://host-or-ip:7891/
# ANDY_OPS_DOZZLE_URL=http://host-or-ip:18080/
# Existing authenticated Grafana dashboard; URLs must not contain credentials.
# ANDY_OPS_NETWORK_OSI_URL=https://grafana.example.test/d/roc-network-osi/roc-network-osi?orgId=1&kiosk&refresh=10s

# Optional read-only WhatsApp transport observability.
# ANDY_OPS_WHATSAPP_TRANSPORT_STATUS_URL=http://transport-host:18103/status
# ANDY_OPS_WHATSAPP_BROWSER_DEBUG_URL=http://browser-host:9223
# ANDY_OPS_ATTENTION_API_READY_URL=http://api-host:18100/health/ready
# ANDY_OPS_WHATSAPP_TRANSPORT_UNIT=attention-whatsapp-transport.service
# ANDY_OPS_WHATSAPP_BROWSER_UNIT=attention-whatsapp-browser.service
# ANDY_OPS_WHATSAPP_OBSERVER_UNIT=attention-whatsapp-observer.service

# Optional bounded message tracing. Keep the real container name outside Git.
ANDY_OPS_MESSAGE_TRACING_ENABLED=false
# ANDY_OPS_TRACE_DB_CONTAINER=runtime-db-container
# ANDY_OPS_TRACE_DB_USER=attention_router
# ANDY_OPS_TRACE_DB_NAME=attention_router
# ANDY_OPS_TRACE_LIMIT=8
