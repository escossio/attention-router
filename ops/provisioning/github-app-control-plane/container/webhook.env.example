# Pilot example only. No production credentials in Git.
GITHUB_WEBHOOK_BIND_HOST=127.0.0.1
GITHUB_WEBHOOK_BIND_PORT=18114
GITHUB_WEBHOOK_REPOSITORY=escossio/attention-router
GITHUB_WEBHOOK_REPOSITORIES=escossio/attention-router,escossio/andy-android
GITHUB_APP_INSTALLATION_ID=10001
GITHUB_WEBHOOK_DB_DIR=/var/lib/attention-router/github-webhook-isolated
GITHUB_WEBHOOK_SECRET_DIR=/etc/attention-router/github-webhook-isolated-secret
