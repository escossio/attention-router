# Only a contract. Do not use real App credentials in source control.
GITHUB_CI_STATE_DIR=/var/lib/attention-router/github-ci-shared
GITHUB_CI_REGISTRY_DIR=/var/lib/attention-router/ci-registry
GITHUB_CI_LOG_DIR=/var/log/attention-router/ci
GITHUB_CI_PROFILES_DIR=/var/lib/attention-router/ci-profiles
GITHUB_CI_CONFIG_DIR=/etc/attention-router/github-app-private
GITHUB_CI_SSH_DIR=/etc/attention-router/ci-ssh-dedicated
GITHUB_CI_CAPACITY_FILE=/etc/attention-router/worker-capacity.json
