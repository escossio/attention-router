FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash openssh-client git util-linux jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir cryptography==46.0.3
WORKDIR /usr/local/lib/andy-github-app
COPY ops/provisioning/github-app-control-plane/probe.py ./probe.py
COPY ops/provisioning/github-app-control-plane/ci_impact_policy.py ./ci_impact_policy.py
COPY ops/provisioning/github-app-control-plane/publisher-containers/preflight.py ./preflight.py
COPY ops/provisioning/github-app-control-plane/distributed_postgres_check.py ./distributed_postgres_check.py
COPY ops/provisioning/github-app-control-plane/distributed_shadow_checks.py ./distributed_shadow_checks.py
COPY ops/provisioning/distributed-ci-lab/control-plane/andy-ci-distributed /usr/local/lib/andy-ci/bin/andy-ci-distributed
COPY ops/provisioning/distributed-ci-lab/control-plane/andy-ci-distributed-suite /usr/local/lib/andy-ci/bin/andy-ci-distributed-suite
COPY ops/provisioning/distributed-ci-lab/control-plane/andy-ci-reprofile /usr/local/lib/andy-ci/bin/andy-ci-reprofile
COPY ops/provisioning/distributed-ci-lab/control-plane/host-registry.py /usr/local/lib/andy-ci/bin/host-registry.py
COPY ops/provisioning/distributed-ci-lab/control-plane/plan-postgres.py /usr/local/lib/andy-ci/bin/plan-postgres.py
COPY ops/provisioning/distributed-ci-lab/control-plane/replan-postgres.py /usr/local/lib/andy-ci/bin/replan-postgres.py
RUN groupadd -g 10001 ci && useradd -u 10001 -g 10001 -d /home/ci -m -s /bin/sh ci \
    && chmod 0555 /usr/local/lib/andy-ci/bin/* && chmod 0444 /usr/local/lib/andy-github-app/*.py
USER 10001:10001
ENV PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/ci \
    ANDY_CI_BASE=/usr/local/lib/andy-ci \
    ANDY_CI_PROFILE_ROOT=/ci-profiles \
    ANDY_CI_LOG_ROOT=/var/log/andy-ci
CMD ["python", "-B", "-c", "import distributed_postgres_check,distributed_shadow_checks,probe; print('OCI_CI_IMPORT_OK')"]
