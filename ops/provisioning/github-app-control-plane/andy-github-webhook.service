[Unit]
Description=Andy GitHub App Webhook Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=andy-github-app
StateDirectoryMode=0750
EnvironmentFile=/etc/andy-github-app/app.env
EnvironmentFile=/etc/andy-github-app/installation.env
Environment=GITHUB_WEBHOOK_HOST=127.0.0.1
Environment=GITHUB_WEBHOOK_PORT=18104
Environment=GITHUB_WEBHOOK_REPOSITORY=escossio/attention-router
Environment=GITHUB_WEBHOOK_MAX_BODY=1048576
LoadCredential=webhook-secret:/etc/andy-github-app/credentials/webhook-secret
ExecStart=/usr/bin/python3 /usr/local/lib/andy-github-app/webhook_receiver.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET
UMask=0077

[Install]
WantedBy=multi-user.target
