      "type": "object"
    },
    "IntegrationResultStatus": {
      "enum": [
        "SUCCEEDED",
        "ACCEPTED",
        "RETRYABLE_FAILURE",
        "PERMANENT_FAILURE"
      ],
      "title": "IntegrationResultStatus",
      "type": "string"
    },
    "IntegrationSource": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "maxLength": 180,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "instance_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Instance Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/IntegrationKind"
        },
        "name": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "instance_id"
      ],
      "title": "IntegrationSource",
      "type": "object"
    },
    "IntegrationThreadKind": {
      "enum": [
        "DIRECT",
        "GROUP",
        "THREAD",
        "CHANNEL"
      ],
      "title": "IntegrationThreadKind",
      "type": "string"
    }
  },
  "$id": "urn:attention-router:integration-contract:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "artifact_receipt": "#/$defs/ArtifactReceiptContract",
      "capability_invocation": "#/$defs/CapabilityInvocationContract",
      "channel_delivery": "#/$defs/ChannelDeliveryContract",
      "inbound_event": "#/$defs/InboundIntegrationEvent",
      "integration_result": "#/$defs/IntegrationResultContract"
    },
    "propertyName": "contract_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ArtifactReceiptContract"
    },
    {
      "$ref": "#/$defs/InboundIntegrationEvent"
    },
    {
      "$ref": "#/$defs/ChannelDeliveryContract"
    },
    {
      "$ref": "#/$defs/CapabilityInvocationContract"
    },
    {
      "$ref": "#/$defs/IntegrationResultContract"
    }
  ]
}
