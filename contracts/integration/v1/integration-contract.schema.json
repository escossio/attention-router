        },
        "payload_ref": {
          "additionalProperties": true,
          "title": "Payload Ref",
          "type": "object"
        },
        "payload_type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Payload Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_binding_id": {
          "maxLength": 120,
          "minLength": 1,
