{
  "$defs": {
    "ArtifactReceiptContract": {
      "additionalProperties": false,
      "properties": {
        "artifact_kind": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Artifact Kind",
          "type": "string"
        },
        "artifact_metadata": {
          "additionalProperties": true,
          "title": "Artifact Metadata",
          "type": "object"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Sha256",
          "type": "string"
        },
        "contract_type": {
          "const": "artifact_receipt",
          "default": "artifact_receipt",
          "title": "Contract Type",
          "type": "string"
        },
        "external_receipt_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "External Receipt Id",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "original_filename": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Filename"
        },
        "receipt_metadata": {
          "additionalProperties": true,
          "title": "Receipt Metadata",
          "type": "object"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "sender": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalActorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/IntegrationSource"
        },
        "storage_provider": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Storage Provider",
          "type": "string"
        },
        "storage_reference": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Storage Reference",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "source",
        "external_receipt_id",
        "content_sha256",
        "artifact_kind",
        "mime_type",
        "size_bytes",
        "storage_provider",
        "storage_reference",
        "received_at"
      ],
      "title": "ArtifactReceiptContract",
      "type": "object"
    },
    "CapabilityInvocationContract": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Capability",
          "type": "string"
        },
        "causation_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "confidence": {
          "default": "medium",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "contract_type": {
          "const": "capability_invocation",
          "default": "capability_invocation",
          "title": "Contract Type",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "integration": {
          "$ref": "#/$defs/IntegrationSource"
        },
        "metadata_sanitized": {
          "additionalProperties": true,
          "title": "Metadata Sanitized",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "resource": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "tenant_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "user_requested": {
          "default": false,
          "title": "User Requested",
          "type": "boolean"
        }
      },
      "required": [
        "tenant_id",
        "integration",
        "capability",
        "idempotency_key",
        "correlation_id"
      ],
      "title": "CapabilityInvocationContract",
      "type": "object"
    },
    "ChannelDeliveryContract": {
      "additionalProperties": false,
