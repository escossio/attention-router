        "correlation_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "integration": {
          "$ref": "#/$defs/IntegrationSource"
        },
        "metadata_sanitized": {
          "additionalProperties": true,
          "title": "Metadata Sanitized",
