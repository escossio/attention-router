    "IntegrationErrorClass": {
      "enum": [
        "AUTHENTICATION",
        "AUTHORIZATION",
        "RATE_LIMIT",
        "TIMEOUT",
        "PROVIDER_UNAVAILABLE",
        "INVALID_REQUEST",
        "NOT_FOUND",
        "CONFLICT",
        "UNKNOWN"
      ],
      "title": "IntegrationErrorClass",
      "type": "string"
    },
    "IntegrationKind": {
      "enum": [
        "CHANNEL",
        "CAPABILITY"
      ],
