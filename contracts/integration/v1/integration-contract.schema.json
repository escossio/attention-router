          "type": "string"
        },
        "external_event_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "External Event Id",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "metadata_sanitized": {
          "additionalProperties": true,
          "title": "Metadata Sanitized",
          "type": "object"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload_ref": {
          "additionalProperties": true,
          "title": "Payload Ref",
          "type": "object"
        },
        "payload_type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Payload Type",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/IntegrationSource"
        },
        "tenant_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
