    "IntegrationResultContract": {
      "additionalProperties": false,
      "properties": {
        "contract_type": {
          "const": "integration_result",
          "default": "integration_result",
          "title": "Contract Type",
          "type": "string"
        },
        "correlation_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Correlation Id",
          "type": "string"
        },
        "details_sanitized": {
          "additionalProperties": true,
          "title": "Details Sanitized",
          "type": "object"
        },
        "error_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationErrorClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "integration": {
          "$ref": "#/$defs/IntegrationSource"
        },
        "provider_reference": {
          "anyOf": [
            {
              "maxLength": 240,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Reference"
        },
        "reason_code": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "request_id": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/IntegrationResultStatus"
