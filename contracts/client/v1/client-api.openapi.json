{
  "openapi": "3.1.0",
  "info": {
    "title": "Attention Router Client API",
    "version": "1"
  },
  "servers": [],
  "paths": {
    "/api/v1/auth/google/challenges": {
      "post": {
        "operationId": "createGoogleHumanAuthChallenge",
        "security": [],
        "responses": {
          "201": {
            "description": "Challenge issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthChallengeResponse"
                }
              }
            }
          },
          "503": {
            "description": "Human Identity feature unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google/challenges/{challenge_id}/verify": {
      "post": {
        "operationId": "verifyGoogleHumanIdentity",
        "security": [],
        "parameters": [
          {
            "name": "challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hac_[A-Za-z0-9_-]{20,}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleHumanIdentityVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Human Identity validated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanIdentityValidatedResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credential rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Challenge not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Challenge already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Challenge expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Provider or feature unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/google/challenges/{challenge_id}/verify-and-continue": {
      "post": {
        "operationId": "verifyGoogleHumanIdentityAndIssueContinuationGrant",
        "security": [],
        "parameters": [
          {
            "name": "challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^hac_[A-Za-z0-9_-]{20,}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleHumanIdentityVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Human Identity validated and a short-lived continuation grant issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanIdentityContinuedResponse"
                }
              }
            }
          },
          "401": {
            "description": "Credential rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Challenge not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Challenge already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Challenge expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Provider or feature unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanAuthErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bootstrap/device/challenges": {
      "post": {
        "operationId": "createDeviceBootstrapChallenge",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceBootstrapChallengeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Device bootstrap challenge issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapChallengeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid device key or descriptor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Continuation grant rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Bootstrap challenge conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Device bootstrap unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/bootstrap/device/challenges/{bootstrap_challenge_id}/complete": {
      "post": {
        "operationId": "completeDeviceBootstrap",
        "security": [],
        "parameters": [
          {
            "name": "bootstrap_challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^dbc_[A-Za-z0-9_-]{20,}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceBootstrapCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device bootstrap authority established",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapEstablishedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or device signature encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Device signature or continuation authority rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Bootstrap challenge not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Challenge consumed or authority conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Bootstrap challenge expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Device bootstrap unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceBootstrapErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/device/challenges": {
      "post": {
        "operationId": "createClientSessionChallenge",
        "description": "Starts short-lived client-session establishment for an already enrolled device. The supplied SPKI and optional tenant id are assertions only. The server derives the device fingerprint, resolves the enrolled ACTIVE device and Human Identity, and validates tenant membership before session issuance.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientSessionChallengeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session possession challenge issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionChallengeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid device key or request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Enrolled device authority rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Active tenant selection required or authority conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Client session establishment unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/device/challenges/{session_challenge_id}/complete": {
      "post": {
        "operationId": "completeClientSessionChallenge",
        "description": "Verifies possession of the already enrolled Android P-256 key and, only after current device, membership and tenant authority are revalidated server-side, issues one short-lived opaque client-session bearer credential.",
        "security": [],
        "parameters": [
          {
            "name": "session_challenge_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^csc_[A-Za-z0-9_-]{20,}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientSessionCompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Short client session established",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionEstablishedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or signature encoding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Device-possession or session authority rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session challenge not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Challenge consumed or active-tenant authority conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Session challenge expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Client session establishment unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/client/bootstrap": {
      "get": {
        "operationId": "getAuthenticatedClientBootstrap",
        "description": "Returns a bounded bootstrap snapshot derived from the authenticated client session and current server-side Human Identity, device, tenant and membership authority. Cached client claims are not authoritative.",
        "security": [
          {
            "ClientSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated bootstrap snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedClientBootstrapSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Missing, unknown, expired or revoked client session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Current device/membership/tenant authority rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Current authority state is inconsistent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Authenticated bootstrap unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSessionErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HumanAuthChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "nonce",
          "expires_at"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "pattern": "^hac_[A-Za-z0-9_-]{20,}$"
          },
          "nonce": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GoogleHumanIdentityVerifyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id_token"
        ],
        "properties": {
          "id_token": {
            "type": "string",
            "minLength": 32,
            "maxLength": 8192
          }
        }
      },
      "HumanIdentityValidatedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "human_identity_id"
        ],
        "properties": {
          "status": {
            "const": "HUMAN_IDENTITY_VALIDATED"
          },
          "human_identity_id": {
            "type": "string",
            "pattern": "^hid_[A-Za-z0-9_-]{20,}$",
            "description": "Opaque Human Identity reference only; not a credential or authority."
          }
        }
      },
      "HumanIdentityContinuedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "human_identity_id",
          "continuation_grant"
        ],
        "properties": {
          "status": {
            "const": "HUMAN_IDENTITY_VALIDATED"
          },
          "human_identity_id": {
            "type": "string",
            "pattern": "^hid_[A-Za-z0-9_-]{20,}$",
            "description": "Opaque Human Identity reference only; not a credential or authority."
          },
          "continuation_grant": {
            "$ref": "#/components/schemas/HumanAuthContinuationGrant"
          }
        }
      },
      "HumanAuthContinuationGrant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "purpose",
          "expires_at"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 47,
            "maxLength": 47,
            "pattern": "^hcg_[A-Za-z0-9_-]{43}$",
            "description": "Sensitive opaque continuation credential; do not log or persist on clients."
          },
          "purpose": {
            "const": "DEVICE_BOOTSTRAP"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HumanAuthErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "HUMAN_AUTH_DISABLED",
              "HUMAN_AUTH_CHALLENGE_NOT_FOUND",
              "HUMAN_AUTH_CHALLENGE_EXPIRED",
              "HUMAN_AUTH_CHALLENGE_CONSUMED",
              "HUMAN_AUTH_CREDENTIAL_REJECTED",
              "HUMAN_AUTH_NONCE_MISMATCH",
              "HUMAN_AUTH_PROVIDER_UNAVAILABLE"
            ]
          }
        }
      },
      "DeviceBootstrapChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "continuation_token",
          "public_key_spki_b64url",
          "canonical_device_name",
          "platform",
          "roles"
        ],
        "properties": {
          "continuation_token": {
            "type": "string",
            "minLength": 47,
            "maxLength": 47,
            "pattern": "^hcg_[A-Za-z0-9_-]{43}$",
            "description": "Sensitive single-use DEVICE_BOOTSTRAP continuation credential; never persist or log."
          },
          "public_key_spki_b64url": {
            "type": "string",
            "minLength": 80,
            "maxLength": 2048,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Unpadded base64url DER SubjectPublicKeyInfo. Server validates P-256 and derives the fingerprint."
          },
          "canonical_device_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "platform": {
            "const": "ANDROID"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "CLIENT",
                "CAPABILITY_NODE"
              ]
            }
          }
        }
      },
      "DeviceBootstrapChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bootstrap_challenge_id",
          "challenge_b64url",
          "expires_at"
        ],
        "properties": {
          "bootstrap_challenge_id": {
            "type": "string",
            "pattern": "^dbc_[A-Za-z0-9_-]{20,}$"
          },
          "challenge_b64url": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeviceBootstrapCompleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_signature_b64url"
        ],
        "properties": {
          "device_signature_b64url": {
            "type": "string",
            "minLength": 64,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "ECDSA/SHA-256 signature over the exact server challenge bytes."
          }
        }
      },
      "ClientTenantMembershipView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "membership_id",
          "tenant_id",
          "role",
          "status"
        ],
        "properties": {
          "membership_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "MEMBER"
            ]
          },
          "status": {
            "const": "ACTIVE"
          }
        }
      },
      "ClientDeviceView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "public_key_fingerprint",
          "canonical_name",
          "platform",
          "roles",
          "status"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "pattern": "^cdev_[A-Za-z0-9_-]{20,}$"
          },
          "public_key_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "canonical_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "platform": {
            "const": "ANDROID"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "CLIENT",
                "CAPABILITY_NODE"
              ]
            }
          },
          "status": {
            "const": "ACTIVE"
          }
        }
      },
      "DeviceBootstrapEstablishedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "human_identity_id",
          "memberships",
          "initial_tenant_id",
          "device"
        ],
        "properties": {
          "status": {
            "const": "DEVICE_BOOTSTRAP_ESTABLISHED"
          },
          "human_identity_id": {
            "type": "string",
            "pattern": "^hid_[A-Za-z0-9_-]{20,}$"
          },
          "memberships": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ClientTenantMembershipView"
            }
          },
          "initial_tenant_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "description": "Server-resolved tenant when unambiguous; null when later active-tenant selection is required."
          },
          "device": {
            "$ref": "#/components/schemas/ClientDeviceView"
          }
        }
      },
      "DeviceBootstrapErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "DEVICE_BOOTSTRAP_GRANT_REJECTED",
              "DEVICE_BOOTSTRAP_CHALLENGE_NOT_FOUND",
              "DEVICE_BOOTSTRAP_CHALLENGE_EXPIRED",
              "DEVICE_BOOTSTRAP_CHALLENGE_CONSUMED",
              "DEVICE_BOOTSTRAP_DEVICE_KEY_INVALID",
              "DEVICE_BOOTSTRAP_SIGNATURE_INVALID",
              "DEVICE_BOOTSTRAP_MEMBERSHIP_CONFLICT",
              "DEVICE_BOOTSTRAP_DEVICE_CONFLICT",
              "DEVICE_BOOTSTRAP_UNAVAILABLE"
            ]
          }
        }
      },
      "ClientSessionChallengeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_key_spki_b64url"
        ],
        "properties": {
          "public_key_spki_b64url": {
            "type": "string",
            "minLength": 80,
            "maxLength": 2048,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Unpadded base64url DER SubjectPublicKeyInfo for the already enrolled P-256 device key. The server derives the fingerprint and resolves device authority; this value is not authority by itself."
          },
          "requested_tenant_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional tenant selection assertion. It grants no authority and must resolve to a current ACTIVE membership."
          }
        }
      },
      "ClientSessionChallengeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_challenge_id",
          "challenge_b64url",
          "expires_at"
        ],
        "properties": {
          "session_challenge_id": {
            "type": "string",
            "pattern": "^csc_[A-Za-z0-9_-]{20,}$"
          },
          "challenge_b64url": {
            "type": "string",
            "minLength": 32,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ClientSessionCompleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_signature_b64url"
        ],
        "properties": {
          "device_signature_b64url": {
            "type": "string",
            "minLength": 64,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "ECDSA/SHA-256 signature over the exact server session challenge bytes."
          }
        }
      },
      "ClientSessionView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "session_token",
          "token_type",
          "expires_at",
          "human_identity_id",
          "device_id",
          "tenant_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^csn_[A-Za-z0-9_-]{20,}$"
          },
          "session_token": {
            "type": "string",
            "minLength": 47,
            "maxLength": 47,
            "pattern": "^cst_[A-Za-z0-9_-]{43}$",
            "description": "Sensitive short-lived opaque bearer credential returned once. Never persist raw server-side or log."
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "human_identity_id": {
            "type": "string",
            "pattern": "^hid_[A-Za-z0-9_-]{20,}$"
          },
          "device_id": {
            "type": "string",
            "pattern": "^cdev_[A-Za-z0-9_-]{20,}$"
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "ClientSessionEstablishedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "session"
        ],
        "properties": {
          "status": {
            "const": "CLIENT_SESSION_ESTABLISHED"
          },
          "session": {
            "$ref": "#/components/schemas/ClientSessionView"
          }
        }
      },
      "AuthenticatedClientBootstrapSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_version",
          "human_identity_id",
          "active_tenant_id",
          "memberships",
          "device",
          "session_expires_at",
          "server_time"
        ],
        "properties": {
          "contract_version": {
            "const": "1"
          },
          "human_identity_id": {
            "type": "string",
            "pattern": "^hid_[A-Za-z0-9_-]{20,}$"
          },
          "active_tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "memberships": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/components/schemas/ClientTenantMembershipView"
            }
          },
          "device": {
            "$ref": "#/components/schemas/ClientDeviceView"
          },
          "session_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ClientSessionErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "CLIENT_SESSION_DEVICE_REJECTED",
              "CLIENT_SESSION_CHALLENGE_NOT_FOUND",
              "CLIENT_SESSION_CHALLENGE_EXPIRED",
              "CLIENT_SESSION_CHALLENGE_CONSUMED",
              "CLIENT_SESSION_SIGNATURE_INVALID",
              "CLIENT_SESSION_ACTIVE_TENANT_REQUIRED",
              "CLIENT_SESSION_TENANT_FORBIDDEN",
              "CLIENT_SESSION_UNAUTHENTICATED",
              "CLIENT_SESSION_AUTHORITY_REJECTED",
              "CLIENT_SESSION_UNAVAILABLE"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "ClientSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque-client-session-v03c",
        "description": "Short-lived opaque client-session credential scoped server-side to Human Identity, device and active tenant."
      }
    }
  }
}
